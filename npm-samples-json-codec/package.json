{
  "name": "@observertc/samples-json-codec",
  "version": "3.5.0",
  "description": "Zero-dependency JSON delta codec for ObserveRTC ClientSamples - encodes each sample as the difference from the previous one",
  "keywords": [
    "observertc",
    "webrtc",
    "json",
    "codec",
    "delta",
    "diff",
    "telemetry",
    "getstats",
    "zero-dependency"
  ],
  "author": "Balazs Kreith",
  "license": "Apache-2.0",
  "homepage": "https://github.com/observertc/schemas/tree/main/npm-samples-json-codec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/observertc/schemas.git",
    "directory": "npm-samples-json-codec"
  },
  "bugs": {
    "url": "https://github.com/observertc/schemas/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && node scripts/finalize-dist.mjs",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-goldens": "UPDATE_GOLDENS=1 vitest run",
    "verify": "npm run typecheck && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
