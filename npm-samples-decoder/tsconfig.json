{
	"compilerOptions":
	{
		"lib": [ "es2020" ],
		"target": "es2020",
		"module": "commonjs",
		"moduleResolution": "node10",
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": true,
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true
	},
	"include": [ "src" ]
}
