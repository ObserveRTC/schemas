{
	"compilerOptions": {
		"lib": [ "es2020", "dom" ],
		"target": "es2020",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": [ "node" ],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [ "src" ]
}
